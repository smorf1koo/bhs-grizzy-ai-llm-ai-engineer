# Copy to .env (never commit .env). Any OpenAI-compatible endpoint works.
# Local, free: Ollama (https://ollama.com) -> `ollama pull qwen2.5-coder:7b`
# Ollama may cut long prompts silently: start it with a larger window,
# e.g. `OLLAMA_CONTEXT_LENGTH=8192 ollama serve` (or set num_ctx in a Modelfile).
GRIZZY_PROVIDER=openai
GRIZZY_BASE_URL=http://localhost:11434/v1
GRIZZY_MODEL=qwen2.5-coder:7b
GRIZZY_API_KEY=ollama
# Upper limit for the answer length
GRIZZY_MAX_TOKENS=2048
# Offline mode without a model: GRIZZY_PROVIDER=replay reads <dir>/<id>/attempt_<n>.txt
GRIZZY_REPLAY_DIR=replay
# Path to the Godot 4.3+ editor binary
GODOT_BIN=godot
